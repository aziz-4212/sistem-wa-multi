	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Pre-request script to validate API key",
					"if (!pm.variables.get('api_key')) {",
					"    console.log('Warning: API key not set in environment variables');",
					"}",
					"",
					"if (!pm.variables.get('base_url')) {",
					"    console.log('Warning: Base URL not set in environment variables');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script",
					"pm.test('Response time is less than 10000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(10000);",
					"});",
					"",
					"pm.test('Response has success field', function () {",
					"    const responseJson = pm.response.json();",
					"    pm.expect(responseJson).to.have.property('success');",
					"});",
					"",
					"pm.test('Status code is 200 for successful requests', function () {",
					"    const responseJson = pm.response.json();",
					"    if (responseJson.success === true) {",
					"        pm.expect(pm.response.code).to.equal(200);",
					"    }",
					"});"
				]
			}
		}
	],
